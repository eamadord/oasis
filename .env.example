# Copia este archivo como .env y rellena los valores.
# Usa solo letras y números en contraseñas y claves.

# Dirección pública de OASIS (con barra final)
PUBLIC_URL=http://localhost:8080/
WEB_PORT=8080

# Base de datos
POSTGRES_USER=tfg
POSTGRES_PASSWORD=CambiaEstaContrasena123
POSTGRES_DB=tfgs

# Clave de Ollama Cloud (ollama.com/settings/keys)
OLLAMA_API_KEY=PonAquiTuClave

# Clave con la que n8n cifra las credenciales. Invéntate una larga y no la cambies después.
N8N_ENCRYPTION_KEY=CambiaEstaClaveLargaDeCifrado0123456789
